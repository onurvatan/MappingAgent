{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AgentWorkflow": {
    "ChatModel": "gpt-4o",
    "EmbeddingModel": "text-embedding-3-small",
    "MaxParallelFiles": 2,
    "RequireReviewBeforeApproval": true
  },
  "Foundry": {
    "Endpoint": "",
    "Deployment": "",
    "ApiKey": ""
  },
  "Storage": {
    "IngestionProvider": "InMemory",
    "ApprovedProvider": "Sqlite",
    "ApprovedConnectionString": "Data Source=mappingagent.db",
    "MongoConnectionString": "mongodb://localhost:27017",
    "MongoDatabaseName": "mapping-agent"
  }
}
